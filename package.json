{
  "name": "idoctor-music-tools-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "store": "node scripts/fetch-store-meta.mjs",
    "build": "vite build && node scripts/postbuild-seo.mjs",
    "build:site": "VITE_BASE=/ VITE_SITE_URL=https://idoctormusic.com npm run build",
    "build:redirect": "node scripts/build-redirect-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run store && npm run build:site && firebase deploy --only hosting:tools",
    "deploy:nostore": "npm run build:site && firebase deploy --only hosting:tools"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.475.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "puppeteer-core": "^25.7.0",
    "tailwindcss": "^3.4.17"
  }
}
